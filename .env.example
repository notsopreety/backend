# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api

# CORS Configuration (comma-separated or * for all)
CORS_ORIGIN=*

# Global Rate Limiting (Default: 100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Strict Rate Limiting for heavy scrapers / downloads (Default: 30 requests per 15 minutes)
STRICT_RATE_LIMIT_WINDOW_MS=900000
STRICT_RATE_LIMIT_MAX=30
